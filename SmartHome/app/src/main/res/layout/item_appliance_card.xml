<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivApplianceIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Appliance Icon"
                android:src="@drawable/ic_fan"
                app:tint="@color/primary_teal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@id/switchAppliance"
                android:layout_toEndOf="@id/ivApplianceIcon"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvApplianceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ceiling Fan"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:fontFamily="@font/poppins_semibold" />

                <TextView
                    android:id="@+id/tvApplianceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ON • Speed 3"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAppliance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:checked="true"
                app:thumbTint="@color/white"
                app:trackTint="@color/switch_track_selector"
                />
        </RelativeLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderApplianceControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:valueFrom="0.0"
            android:valueTo="5.0"
            android:stepSize="1.0"
            android:value="3.0"
            android:visibility="gone"
            app:haloColor="#33008080"
            app:thumbColor="@color/primary_teal"
            app:trackColorActive="@color/primary_teal"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>